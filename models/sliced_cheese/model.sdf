<?xml version="1.0"?>

<sdf version="1.6">

  <model name="sliced_cheese">

    <static>false</static>

    <link name="link">

      <visual name="visual">

        <geometry>
          <mesh>
            <uri>model://sliced_cheese/meshes/cheeseCut.obj</uri>
            <scale>0.24 0.24 0.24</scale>
          </mesh>
        </geometry>

      </visual>


      <collision name="collision">

        <geometry>
          <mesh>
            <uri>model://sliced_cheese/meshes/cheeseCut.obj</uri>
            <scale>0.24 0.24 0.24</scale>
          </mesh>
        </geometry>

      </collision>

    </link>

  </model>

</sdf>
